# Python 스크립트(main.py, app.py, phrase_bank_builder.py)용 — 서버/CLI 전용, 절대 VITE_ 접두사 붙이지 말 것
OPENAI_API_KEY=
EXA_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
# phrase_bank_builder.py 전용. Supabase 대시보드 → Settings → API Keys →
# "Legacy anon, service_role API keys" 탭에서 복사. RLS를 우회하는 강력한 키라서
# 이 스크립트(서버/CLI) 외에는 절대 쓰지 말고, 프론트엔드 코드 근처에도 두지 말 것.
SUPABASE_SERVICE_ROLE_KEY=

# 웹앱(Vite, 브라우저)용 — Supabase 대시보드 > Settings > API 에서 발급
# anon/public 키만 넣을 것. service_role 키를 넣으면 브라우저에 노출됨.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
